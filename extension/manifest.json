{
  "manifest_version": 3,
  "name": "ALLPWST Discord Data",
  "version": "1.0",
  "description": "Sends sales from #danielbehnam-sales on Discord to your Business Hub.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://discord.com/*",
    "https://jhbhkjomjjbldlofuigt.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://discord.com/channels/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "ALLPWST Discord Data",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "web_accessible_resources": [
    { "resources": ["icon48.png"], "matches": ["https://discord.com/*"] }
  ]
}
