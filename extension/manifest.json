{
  "manifest_version": 3,
  "name": "ALLPWST Discord Data",
  "version": "1.2",
  "description": "Sends your Discord sales (#danielbehnam-sales, #plt-sales) and your inventory Google Sheet to your Business Hub.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://jhbhkjomjjbldlofuigt.supabase.co/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dan5503.github.io/ticket-business-hub/*"
      ],
      "js": [
        "hubbridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ALLPWST Discord Data",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon48.png"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    }
  ]
}